#!/bin/sh
# BirdPi Control Script
# Jonathan Emrich - 2025
#
# Controls the BirdPi daemon process:
#   - Starts bird_daemon.py (through the startup script)
#   - Stops the daemon cleanly
#   - Reports whether it is running
#   - Restarts the daemon
#   - Provides a help section
#
# The daemon PID is tracked in: /tmp/bird_daemon.pid
# Logs are stored in: /mnt/mmcblk0p2/tc/birdpi-logs
#

VENV_DIR="/mnt/mmcblk0p2/tc/birdpi-venv"
APP_ROOT="/mnt/mmcblk0p2/tc/SquawkersMccaw"
STARTUP_SH="${APP_ROOT}/birdpi-startup.sh"
LOG_DIR="/mnt/mmcblk0p2/tc/birdpi-logs"
PID_FILE="/tmp/bird_daemon.pid"

# -------------------------------------------------------------------
# Always run as root (needed to signal root-owned daemon)
# -------------------------------------------------------------------
if [ "$(id -u)" -ne 0 ] && [ -z "$BIRDCTL_ELEVATED" ]; then
    # Re-run ourselves via sudo, preserving arguments.
    BIRDCTL_ELEVATED=1 exec sudo BIRDCTL_ELEVATED=1 "$0" "$@"
fi

# -------------------------------------------------------------------
# Helpers
# -------------------------------------------------------------------

ensure_log_dir() {
    [ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR"
}

log() {
    ensure_log_dir
    echo "[birdctl] $(date +'%Y-%m-%dT%H:%M:%S') $*" >> "${LOG_DIR}/birdctl.log"
}

get_pid() {
    if [ -f "$PID_FILE" ]; then
        PID="$(cat "$PID_FILE" 2>/dev/null)"
        echo "$PID"
        return 0
    fi
    return 1
}

is_running() {
    PID="$(get_pid)" || return 1

    if [ -z "$PID" ]; then
        return 1
    fi

    # kill -0 checks if the process exists without actually killing it
    if kill -0 "$PID" 2>/dev/null; then
        return 0
    fi

    # If kill -0 fails, the PID file is stale
    return 1
}

do_status() {
    if is_running; then
        PID="$(get_pid)"
        echo "Bird daemon is RUNNING (PID $PID)"
        log "status: running (PID $PID)"
    else
        echo "Bird daemon is NOT running"
        log "status: not running"
    fi
}

do_start() {
    if is_running; then
        PID="$(get_pid)"
        echo "Bird daemon is already running (PID $PID)"
        log "start: already running (PID $PID)"
        return 0
    fi

    if [ ! -x "$STARTUP_SH" ]; then
        echo "ERROR: Startup script not found or not executable: $STARTUP_SH"
        log "start: missing startup script $STARTUP_SH"
        return 1
    fi

    echo "Starting Bird daemon..."
    log "start: invoking $STARTUP_SH"
    sh "$STARTUP_SH" >/dev/null 2>&1 &

    # Give it a moment to write the PID file
    sleep 1

    if is_running; then
        PID="$(get_pid)"
        echo "Bird daemon started (PID $PID)"
        log "start: daemon started (PID $PID)"
        return 0
    else
        echo "ERROR: Bird daemon failed to start. Check logs in $LOG_DIR."
        log "start: failed to start; not running after startup"
        return 1
    fi
}

do_stop() {
    if ! is_running; then
        echo "Bird daemon is NOT running"
        log "stop: not running"
        return 0
    fi

    PID="$(get_pid)"
    echo "Stopping Bird daemon (PID $PID)..."
    log "stop: sending SIGTERM to PID $PID"

    kill "$PID" 2>/dev/null || {
        echo "WARNING: Failed to send SIGTERM to PID $PID"
        log "stop: SIGTERM failed for PID $PID"
    }

    # Wait a bit for clean shutdown
    for i in 1 2 3 4 5; do
        if ! kill -0 "$PID" 2>/dev/null; then
            break
        fi
        sleep 1
    done

    if kill -0 "$PID" 2>/dev/null; then
        echo "Daemon did not exit; sending SIGKILL..."
        log "stop: SIGTERM failed, sending SIGKILL to PID $PID"
        kill -9 "$PID" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    echo "Bird daemon stopped."
    log "stop: daemon stopped and PID file removed"
}

do_restart() {
    log "restart: requested"
    do_stop
    do_start
}

do_help() {
    cat <<EOF
BirdPi control script

Usage:
  birdctl status    - Show whether the Bird daemon is running
  birdctl start     - Start the Bird daemon
  birdctl stop      - Stop the Bird daemon
  birdctl restart   - Restart the Bird daemon
  birdctl help      - Show this help

Notes:
  - The daemon PID file is: $PID_FILE
  - Logs are under:        $LOG_DIR
  - Startup script:        $STARTUP_SH
EOF
}

# -------------------------------------------------------------------
# Main dispatch
# -------------------------------------------------------------------

case "$1" in
    help|-h|--help) do_help ;;
    status) do_status ;;
    start) do_start ;;
    stop) do_stop ;;
    restart) do_restart ;;
    *)
        echo "Unknown command: $1"
        echo "Run: birdctl help"
        exit 1
    ;;
esac
