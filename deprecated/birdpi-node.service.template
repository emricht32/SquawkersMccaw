[Unit]
Description=BirdPi Node Registration Agent
After=network-online.target
Wants=network-online.target

[Service]
#
# --- Configuration ---
#
# 1. Set the path to your project directory.
# 2. Set the Master Pi's IP address.
# 3. (Optional) Set a specific bird name.
#
# After editing, copy this file to /etc/systemd/system/birdpi-node.service
# Then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable birdpi-node.service
#   sudo systemctl start birdpi-node.service
#
# To see logs:
#   journalctl -u birdpi-node.service -f
#
Type=simple
User=pi
WorkingDirectory=/home/pi/SquawkersMccaw

# Option 1: Basic, using default master IP from the script
# ExecStart=/usr/bin/python3 src/birdpi_node/registration_agent.py

# Option 2: Explicit master IP and bird name
ExecStart=/usr/bin/python3 src/birdpi_node/registration_agent.py --master-ip 192.168.1.100 --name Jose

# --- Venv ---
# If you are using a virtual environment, use this ExecStart line instead:
# ExecStart=/home/pi/SquawkersMccaw/.venv/bin/python3 src/birdpi_node/registration_agent.py --master-ip 192.168.1.100 --name Jose

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
